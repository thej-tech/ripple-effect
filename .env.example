# Local-only values. Compose does not URL-encode DATABASE_URL credentials.
# Use only URL-unreserved characters in POSTGRES_PASSWORD: letters, digits, . _ ~ -
POSTGRES_USER=ripple_effect
POSTGRES_PASSWORD=replace-with-a-local-only-url-safe-password
POSTGRES_DB=ripple_effect
# Synthetic demo workspaces are opt-in; fresh installations start empty.
SEED_DEMO_DATA=false
# Keep the backend on the private Compose network; do not use localhost here.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
